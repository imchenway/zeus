+/// 只识别 macOS 单窗口共享的非键盘状态面板，普通对话框与未知属性仍保留互斥。
+unsafe fn is_window_sharing_status_panel(window: AXUIElementRef) -> bool {
+    if copy_string_attr(window, "AXSubrole").as_deref() != Some("AXDialog")
+        || copy_bool_attr(window, "AXModal") != Some(false)
+        || copy_bool_attr(window, "AXMain") != Some(false)
+    {
+        return false;
+    }
+    // 系统状态面板不能成为主窗口，属性不可读时禁止排除。
+    let main_attribute = CFString::new("AXMain");
+    // 原生返回的可写事实，不以窗口标题或尺寸推测输入能力。
+    let mut main_settable = 0u8;
+    if AXUIElementIsAttributeSettable(
+        window,
+        main_attribute.as_concrete_TypeRef(),
+        &mut main_settable,
+    ) != kAXErrorSuccess
+        || main_settable != 0
+    {
+        return false;
+    }
+    // 共享按钮是系统面板的唯一直接子控件，不放宽其他同进程窗口。
+    let children = copy_children(window);
+    // 只有完整匹配真实系统控件身份才排除其键盘目的地。
+    let is_status_panel = children.len() == 1
+        && copy_string_attr(children[0], "AXRole").as_deref() == Some("AXButton")
+        && copy_string_attr(children[0], "AXTitle").as_deref()
+            == Some("WindowSharingSessionButton");
+    for child in children {
+        CFRelease(child as CFTypeRef);
+    }
+    is_status_panel
+}
