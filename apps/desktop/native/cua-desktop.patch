+const USER_CONTROL: &str = "ZEUS_COMPUTER_USER_CONTROL";
+/// 屏幕布局变化后必须重新观察的原因。
+const DISPLAY_CHANGED: &str = "ZEUS_COMPUTER_DISPLAY_CHANGED";
+/// 系统共享入口停止或撤销采集时的暂停原因。
+const SHARING_STOPPED: &str = "ZEUS_COMPUTER_SHARING_STOPPED";
+/// 本轮原生调用的取消信号，仅在下一次私有请求开始时重置。
+static CANCELLED: AtomicBool = AtomicBool::new(false);
+/// 原生输入监听是否实际建立且具有辅助功能授权。
+static MONITOR_READY: AtomicBool = AtomicBool::new(false);
+/// 只统计其他应用的实体键盘事件数量，验收并行输入时不读取任何文本。
+static OTHER_KEYBOARD_EVENTS: AtomicU64 = AtomicU64::new(0);
+/// 生命周期会话与其成功观察的精确窗口。
+static WINDOWS: OnceLock<Mutex<HashMap<String, HashSet<(i32, u32)>>>> = OnceLock::new();
+/// 用户让权和屏幕失效按应用记录，保护同一应用共享的菜单及键盘焦点。
+static PAUSED: OnceLock<Mutex<HashMap<i32, &'static str>>> = OnceLock::new();
+/// 实体拖动的起始应用，穿过其他窗口时不会改认输入归属。
+static USER_DRAG: Mutex<Option<i32>> = Mutex::new(None);
+
+/// 取得进程内的窗口记录，不把用户输入或会话身份落盘。
+fn windows() -> &'static Mutex<HashMap<String, HashSet<(i32, u32)>>> {
+    WINDOWS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+/// 取得应用暂停原因。
+fn paused() -> &'static Mutex<HashMap<i32, &'static str>> {
+    PAUSED.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+/// 一次性密钥仅从宿主提供的私有环境读取，不接受应用文本或模型参数。
+fn event_token() -> Option<&'static str> {
+    /// worker 生命周期内固定，避免事件处理反复读取环境。
+    static TOKEN: OnceLock<Option<String>> = OnceLock::new();
+    TOKEN
+        .get_or_init(|| {
+            std::env::var("ZEUS_CUA_EVENT_TOKEN").ok().filter(|token| {
+                token.len() == 64
+                    && token
+                        .bytes()
+                        .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+            })
+        })
+        .as_deref()
+}
+
+/// 信号处理器只写原子状态，不调用 AppKit 或持锁。
+extern "C" fn cancel_signal(_: i32) {
+    CANCELLED.store(true, Ordering::Release);
+}
+
+/// 安装会话清理和私有进程取消入口，重复初始化没有副作用。
+pub fn init() {
+    static INITIALIZED: OnceLock<()> = OnceLock::new();
+    INITIALIZED.get_or_init(|| {
+        crate::window_sharing::init();
+        unsafe {
+            libc::signal(
+                libc::SIGUSR1,
+                cancel_signal as *const () as libc::sighandler_t,
+            );
+        }
+        cua_driver_core::session::register_session_end_hook(|session| {
+            crate::window_sharing::end_session(session);
+            let remaining = {
+                let mut records = windows().lock().unwrap();
+                records.remove(session);
+                records
+                    .values()
+                    .flat_map(|entries| entries.iter().map(|(pid, _)| *pid))
+                    .collect::<HashSet<_>>()
+            };
+            paused()
+                .lock()
+                .unwrap()
+                .retain(|pid, _| remaining.contains(pid));
+        });
+    });
+}
+
+/// 每个串行私有请求开始时建立新的取消边界。
+pub fn begin_operation() {
+    CANCELLED.store(false, Ordering::Release);
+}
+
+/// 成功观察后登记窗口；新观察仅解除显示器失效，不解除用户接管。
+pub fn observe_window(session: &str, pid: i32, window_id: u32) -> anyhow::Result<()> {
+    windows()
+        .lock()
+        .unwrap()
+        .entry(session.to_owned())
+        .or_default()
+        .insert((pid, window_id));
+    let mut reasons = paused().lock().unwrap();
+    if reasons.get(&pid) == Some(&DISPLAY_CHANGED) {
+        reasons.remove(&pid);
+    }
+    drop(reasons);
+    if let Err(error) = crate::window_sharing::observe_window(session, pid, window_id) {
+        if let Some(records) = windows().lock().unwrap().get_mut(session) {
+            records.remove(&(pid, window_id));
+        }
+        return Err(error);
+    }
+    Ok(())
+}
+
+/// 立即撤销整个应用，系统停止和实体用户操作使用同一输入边界。
+fn pause_application(pid: i32, reason: &'static str) {
+    let sessions = windows()
+        .lock()
+        .unwrap()
+        .iter()
+        .filter(|(_, entries)| entries.iter().any(|(target, _)| *target == pid))
+        .map(|(session, _)| session.clone())
+        .collect::<Vec<_>>();
+    if sessions.is_empty() || paused().lock().unwrap().insert(pid, reason) == Some(reason) {
+        return;
+    }
+    for session in sessions {
+        crate::cursor::overlay::send_command(
+            session,
+            cursor_overlay::OverlayCommand::SetEnabled(false),
+        );
+    }
+    crate::window_sharing::stop_application(pid);
+    // 固定前缀只传受控身份与原因，通过私有进程 stderr 即时通知宿主。
+    if let Some(token) = event_token() {
+        eprintln!("_ZEUS_COMPUTER_EVENT_ {{\"token\":\"{}\",\"workerPid\":{},\"pid\":{},\"reason\":\"{}\",\"otherKeyboardEvents\":{}}}", token, std::process::id(), pid, reason, OTHER_KEYBOARD_EVENTS.load(Ordering::Acquire));
+    }
+}
+
+/// 系统窗口共享停止后不能自动重开，必须结束旧会话并接受新指令。
+pub fn sharing_stopped(pid: i32) {
+    pause_application(pid, SHARING_STOPPED);
+}
+
+/// 为窗口观察附加真实监听与让权状态，不改变截图或控件身份。
+pub fn state(pid: i32) -> serde_json::Value {
+    let reason = paused().lock().unwrap().get(&pid).copied();
+    serde_json::json!({ "monitoring": MONITOR_READY.load(Ordering::Acquire), "events_ready": event_token().is_some(), "paused": reason.is_some(), "reason": reason, "other_keyboard_events": OTHER_KEYBOARD_EVENTS.load(Ordering::Acquire) })
+}
+
+/// 输入前检查取消和用户优先；既有按键、按钮的抬起不经过本闸门。
+pub fn check_pid(pid: i32) -> anyhow::Result<()> {
+    if CANCELLED.load(Ordering::Acquire) {
+        anyhow::bail!("ZEUS_COMPUTER_STOPPED: 当前后台动作已取消，结果需要重新观察。");
+    }
+    if let Some(reason) = paused().lock().unwrap().get(&pid).copied() {
+        anyhow::bail!("{reason}: 用户已接管或显示器布局已变化，停止后台输入并重新观察。");
+    }
+    if !MONITOR_READY.load(Ordering::Acquire) {
+        anyhow::bail!("ZEUS_COMPUTER_INPUT_MONITOR_UNAVAILABLE: 用户操作监听不可用，未投递后台输入，请检查辅助功能授权。");
+    }
+    Ok(())
+}
+
+/// 有界等待持续检查取消，让长拖动也能及时抬起按钮。
+pub fn wait(pid: i32, milliseconds: u64) -> anyhow::Result<()> {
+    let deadline = std::time::Instant::now() + std::time::Duration::from_millis(milliseconds);
+    loop {
+        check_pid(pid)?;
+        let remaining = deadline.saturating_duration_since(std::time::Instant::now());
+        if remaining.is_zero() {
+            return Ok(());
+        }
+        std::thread::sleep(remaining.min(std::time::Duration::from_millis(16)));
+    }
+}
+
+/// 热插拔或缩放变化使所有已观察应用失效，不能用旧坐标继续输入。
+pub fn display_changed() {
+    let pids = windows()
+        .lock()
+        .unwrap()
+        .values()
+        .flat_map(|entries| entries.iter().map(|(pid, _)| *pid))
+        .collect::<HashSet<_>>();
+    let mut reasons = paused().lock().unwrap();
+    for pid in pids {
+        reasons.entry(pid).or_insert(DISPLAY_CHANGED);
+    }
+}
+
+/// 给虚拟事件加进程内标记，监听器只处理真实或来源不明的外部输入。
+pub fn stamp_event(event: *mut c_void) {
+    crate::input::skylight::set_integer_field(event, 42, VIRTUAL_EVENT_COOKIE);
+}
+
+/// 判断鼠标事件实际命中的普通窗口，跳过透明光标浮层。
+fn mouse_pid(event: *mut c_void) -> Option<i32> {
+    extern "C" {
+        fn CGEventGetIntegerValueField(event: *mut c_void, field: u32) -> i64;
+        fn CGEventGetLocation(event: *mut c_void) -> core_graphics::geometry::CGPoint;
+    }
+    let window_id = unsafe { CGEventGetIntegerValueField(event, 92) };
+    if let Ok(window_id) = u32::try_from(window_id) {
+        if window_id > 0 && !crate::cursor::overlay::is_overlay_window(window_id) {
+            if let Some(window) = crate::windows::window_info_by_id(window_id) {
+                return Some(window.pid);
+            }
+        }
+    }
+    let point = unsafe { CGEventGetLocation(event) };
+    crate::windows::visible_windows()
+        .iter()
+        .filter(|window| {
+            window.is_on_screen
+                && window.layer == 0
+                && !crate::cursor::overlay::is_overlay_window(window.window_id)
+                && point.x >= window.bounds.x
+                && point.x < window.bounds.x + window.bounds.width
+                && point.y >= window.bounds.y
+                && point.y < window.bounds.y + window.bounds.height
+        })
+        .max_by_key(|window| window.z_index)
+        .map(|window| window.pid)
+}
+
+/// 只记录应用归属，不读取或保存按键、文本和剪贴板内容。
+unsafe fn user_event(event: *mut objc2::runtime::AnyObject) {
+    use objc2::msg_send;
+    if windows().lock().unwrap().is_empty() {
+        return;
+    }
+    let cg_event: *mut c_void = msg_send![event, CGEvent];
+    if cg_event.is_null() {
+        return;
+    }
+    extern "C" {
+        fn CGEventGetIntegerValueField(event: *mut c_void, field: u32) -> i64;
+    }
+    if CGEventGetIntegerValueField(cg_event, 42) == VIRTUAL_EVENT_COOKIE {
+        return;
+    }
+    let kind: u64 = msg_send![event, type];
+    let pid = match kind {
+        10 | 11 | 12 => crate::apps::frontmost_pid(),
+        1 | 3 | 25 => {
+            let pid = mouse_pid(cg_event);
+            *USER_DRAG.lock().unwrap() = pid;
+            pid
+        }
+        6 | 7 | 27 => *USER_DRAG.lock().unwrap(),
+        2 | 4 | 26 => {
+            *USER_DRAG.lock().unwrap() = None;
+            return;
+        }
+        22 => mouse_pid(cg_event),
+        _ => None,
+    };
+    if let Some(pid) = pid {
+        let controlled = windows()
+            .lock()
+            .unwrap()
+            .values()
+            .any(|entries| entries.iter().any(|(target, _)| *target == pid));
+        if controlled {
+            pause_application(pid, USER_CONTROL);
+        } else if matches!(kind, 10 | 11 | 12) {
+            OTHER_KEYBOARD_EVENTS.fetch_add(1, Ordering::AcqRel);
+        }
+    }
+}
+
+/// 在 AppKit 主线程安装只读全局监听；普通鼠标移动不触发暂停。
+pub unsafe fn install_monitor() {
+    use objc2::runtime::AnyObject;
+    use objc2::{class, msg_send};
+    /// 鼠标按下、抬起、拖动、滚动及键盘事件的原生掩码。
+    const MASK: u64 = (1 << 1)
+        | (1 << 2)
+        | (1 << 3)
+        | (1 << 4)
+        | (1 << 6)
+        | (1 << 7)
+        | (1 << 10)
+        | (1 << 11)
+        | (1 << 12)
+        | (1 << 22)
+        | (1 << 25)
+        | (1 << 26)
+        | (1 << 27);
+    let block = block2::RcBlock::new(|event: *mut AnyObject| {
+        user_event(event);
+    });
+    let monitor: *mut AnyObject =
+        msg_send![class!(NSEvent), addGlobalMonitorForEventsMatchingMask: MASK handler: &*block];
+    extern "C" {
+        fn AXIsProcessTrusted() -> bool;
+    }
+    MONITOR_READY.store(
+        !monitor.is_null() && AXIsProcessTrusted(),
+        Ordering::Release,
+    );
+}
+
+/// 用户主动进入应用时，禁止焦点保护把用户切回之前的应用。
+pub fn user_has_control(pid: i32) -> bool {
+    matches!(
+        paused().lock().unwrap().get(&pid),
+        Some(&USER_CONTROL) | Some(&SHARING_STOPPED)
+    )
+}
+
+/// 只读原生等待允许被取消，不等待原谓词窗口超时。
+pub async fn wait_for_cancellation() {
+    while !CANCELLED.load(Ordering::Acquire) {
+        tokio::time::sleep(std::time::Duration::from_millis(16)).await;
+    }
+}
diff --git a/crates/platform-macos/src/window_sharing.rs b/crates/platform-macos/src/window_sharing.rs
new file mode 100644
--- /dev/null
+++ b/crates/platform-macos/src/window_sharing.rs
@@ -0,0 +1,600 @@
+//! Zeus 的真实单窗口共享、有限帧缓存及系统停止生命周期。
+
+use image::ImageEncoder;
+use screencapturekit::cm::{CMClock, CMSampleBuffer, CMSampleBufferExt, CMTime, SCFrameStatus};
+use screencapturekit::prelude::{
+    SCContentFilter, SCShareableContent, SCStream, SCStreamConfiguration,
+};
+use screencapturekit::stream::{
+    configuration::PixelFormat, delegate_trait::SCStreamDelegateTrait,
+    output_type::SCStreamOutputType,
+};
+use std::collections::{HashMap, HashSet};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc, Condvar, Mutex, OnceLock};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+/// 活跃共享数量受限，不允许观察不断积累原生流。
+const MAX_SHARED_WINDOWS: usize = 8;
+/// 每张原生图片的像素内存上限，先检查再创建系统流。
+const MAX_FRAME_BYTES: usize = 64 * 1024 * 1024;
+/// 实际共享以每秒十帧验证窗口变化，静止帧不复制或编码。
+const FRAME_INTERVAL: i64 = 100;
+/// 读取一张新验证帧的等待上限。
+const FRAME_TIMEOUT: Duration = Duration::from_secs(2);
+/// 会话共享的精确窗口及唯一系统流。
+static SHARES: OnceLock<Mutex<HashMap<(i32, u32), Arc<WindowShare>>>> = OnceLock::new();
+/// AppKit 回调只排队清理，禁止同步等待系统流停止。
+static STOP_QUEUE: OnceLock<mpsc::SyncSender<Vec<Arc<WindowShare>>>> = OnceLock::new();
+
+/// 最新像素只有一份系统缓冲；帧状态验证和实际图像分别记录。
+struct SharedFrame {
+    /// 系统拥有的当前完整帧，替换时直接释放上一帧。
+    sample: Option<CMSampleBuffer>,
+    /// 包含完整帧或静止通知的最近真实系统采样时间。
+    verified_at: Option<f64>,
+    /// 当前配置要求的像素尺寸，更新配置前先排除旧帧。
+    expected_size: (usize, usize),
+}
+
+/// 一个固定窗口的共享范围、所有者及可取消帧等待。
+struct WindowShare {
+    /// 系统应用身份，停止时只让权给该应用。
+    pid: i32,
+    /// 系统窗口身份，禁止扩大为显示器或整个应用采集。
+    window_id: u32,
+    /// 共用此窗口的原生命名会话。
+    sessions: Mutex<HashSet<String>>,
+    /// 创建和停止共用一个锁，不能出现停止后才启动的流。
+    stream: Mutex<Option<SCStream>>,
+    /// 主动结束与系统停止都立即使旧帧和输入失效。
+    stopped: AtomicBool,
+    /// 系统流已成功启动，不能把准备阶段当作可用。
+    active: AtomicBool,
+    /// 系统共享的真实时钟，用于转换帧采集时间而非回调到达时间。
+    source_clock: OnceLock<CMClock>,
+    /// 成功配置对应的窗口几何，移动和缩放后重新核对配置。
+    geometry: Mutex<Option<[f64; 4]>>,
+    /// 最后交付图片的真实采集时间，不把编码完成或工具返回当成采集。
+    captured_at: Mutex<Option<u64>>,
+    /// 有界的最新完整帧和验证时间。
+    frame: Mutex<SharedFrame>,
+    /// 截图等待由系统输出唤醒，不轮询或重放旧输入。
+    ready: Condvar,
+}
+
+/// 系统共享停止和窗口关闭回调持有弱引用，避免与流形成引用环。
+struct ShareDelegate(std::sync::Weak<WindowShare>);
+
+impl SCStreamDelegateTrait for ShareDelegate {
+    /// 系统停止、权限撤销或采集错误都撤销该应用的后台输入。
+    fn did_stop_with_error(&self, _error: screencapturekit::error::SCError) {
+        if let Some(share) = self.0.upgrade() {
+            if !share.stopped.swap(true, Ordering::AcqRel) {
+                share.active.store(false, Ordering::Release);
+                share.ready.notify_all();
+                crate::input::user_guard::sharing_stopped(share.pid);
+            }
+        }
+    }
+
+    /// 共享窗口全部关闭时立即撤销，不允许等待下一次模型操作。
+    fn stream_did_become_inactive(&self) {
+        if let Some(share) = self.0.upgrade() {
+            if !share.stopped.swap(true, Ordering::AcqRel) {
+                share.active.store(false, Ordering::Release);
+                share.ready.notify_all();
+                crate::input::user_guard::sharing_stopped(share.pid);
+            }
+        }
+    }
+}
+
+/// 取得本 worker 的共享表，不存储截图文件或用户输入。
+fn shares() -> &'static Mutex<HashMap<(i32, u32), Arc<WindowShare>>> {
+    SHARES.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+/// 系统宿主时钟与共享帧时钟统一，积压的旧帧不能冒充新截图。
+fn host_clock() -> &'static CMClock {
+    /// 全 worker 复用系统只读时钟，不生成输入或额外线程。
+    static CLOCK: OnceLock<CMClock> = OnceLock::new();
+    CLOCK.get_or_init(CMClock::host_time_clock)
+}
+
+/// 使用 CoreMedia 正式时钟 API，绑定提供的占位 time() 不作为证据。
+fn host_seconds() -> anyhow::Result<f64> {
+    extern "C" {
+        fn CMClockGetTime(clock: *const std::ffi::c_void) -> CMTime;
+    }
+    unsafe { CMClockGetTime(host_clock().as_ptr()) }
+        .as_seconds()
+        .filter(|time| time.is_finite())
+        .ok_or_else(|| anyhow::anyhow!("无法读取窗口采集宿主时钟。"))
+}
+
+/// 将实际帧时间转换到宿主时钟，不使用帧送达时刻替代采集时刻。
+fn sample_seconds(share: &WindowShare, sample: &CMSampleBuffer) -> Option<f64> {
+    extern "C" {
+        fn CMSyncConvertTime(
+            time: CMTime,
+            source: *const std::ffi::c_void,
+            target: *const std::ffi::c_void,
+        ) -> CMTime;
+    }
+    let source = share.source_clock.get()?;
+    unsafe {
+        CMSyncConvertTime(
+            sample.presentation_timestamp(),
+            source.as_ptr(),
+            host_clock().as_ptr(),
+        )
+    }
+    .as_seconds()
+    .filter(|time| time.is_finite())
+}
+
+/// Apple 帧状态附件是 CFNumber，按官方整数契约读取后转换，不能直接转成 Swift 枚举。
+fn frame_status(sample: &CMSampleBuffer) -> Option<SCFrameStatus> {
+    extern "C" {
+        /// 当前系统的状态附件键，由 ScreenCaptureKit 提供。
+        static SCStreamFrameInfoStatus: *const std::ffi::c_void;
+        /// 只读取得样本附件，生命周期由本次 sample 保证。
+        fn CMSampleBufferGetSampleAttachmentsArray(
+            sample: *const std::ffi::c_void,
+            create: bool,
+        ) -> *const std::ffi::c_void;
+        /// 附件数组的实际长度。
+        fn CFArrayGetCount(array: *const std::ffi::c_void) -> isize;
+        /// 只读取第一个帧附件字典。
+        fn CFArrayGetValueAtIndex(
+            array: *const std::ffi::c_void,
+            index: isize,
+        ) -> *const std::ffi::c_void;
+        /// 按系统键取得帧状态数字。
+        fn CFDictionaryGetValue(
+            dictionary: *const std::ffi::c_void,
+            key: *const std::ffi::c_void,
+        ) -> *const std::ffi::c_void;
+        /// 核对附件的实际 CoreFoundation 类型。
+        fn CFGetTypeID(value: *const std::ffi::c_void) -> usize;
+        /// CoreFoundation 数字类型身份。
+        fn CFNumberGetTypeID() -> usize;
+        /// 以有符号整数读取系统状态，不推测未知状态。
+        fn CFNumberGetValue(number: *const std::ffi::c_void, kind: isize, value: *mut i64) -> bool;
+    }
+    // 所有指针只在系统拥有的样本回调期间使用，不保留附件或创建额外缓存。
+    unsafe {
+        let attachments = CMSampleBufferGetSampleAttachmentsArray(sample.as_ptr(), false);
+        if attachments.is_null() || CFArrayGetCount(attachments) == 0 {
+            return None;
+        }
+        let dictionary = CFArrayGetValueAtIndex(attachments, 0);
+        if dictionary.is_null() {
+            return None;
+        }
+        let value = CFDictionaryGetValue(dictionary, SCStreamFrameInfoStatus);
+        if value.is_null() || CFGetTypeID(value) != CFNumberGetTypeID() {
+            return None;
+        }
+        /// kCFNumberSInt64Type 的官方值，用来接收 NSInteger 状态。
+        const SIGNED_64: isize = 4;
+        // 仅保存本次附件中的整数状态。
+        let mut raw = 0i64;
+        if !CFNumberGetValue(value, SIGNED_64, &mut raw) {
+            return None;
+        }
+        i32::try_from(raw).ok().and_then(SCFrameStatus::from_raw)
+    }
+}
+
+/// 用 WindowServer 的实际几何判断是否必须刷新尺寸及每屏缩放。
+fn current_geometry(share: &WindowShare) -> anyhow::Result<[f64; 4]> {
+    let info = crate::windows::window_info_by_id(share.window_id)
+        .filter(|window| window.pid == share.pid)
+        .ok_or_else(|| {
+            anyhow::anyhow!("ZEUS_COMPUTER_WINDOW_CHANGED: 共享窗口的应用身份已变化。")
+        })?;
+    Ok([
+        info.bounds.x,
+        info.bounds.y,
+        info.bounds.width,
+        info.bounds.height,
+    ])
+}
+
+/// 建立唯一清理线程，最多容纳全部活跃流的停止请求。
+pub fn init() {
+    STOP_QUEUE.get_or_init(|| {
+        let (sender, receiver) =
+            mpsc::sync_channel::<Vec<Arc<WindowShare>>>(MAX_SHARED_WINDOWS * 2);
+        std::thread::Builder::new()
+            .name("zeus-window-share-stop".to_owned())
+            .spawn(move || {
+                for targets in receiver {
+                    for share in targets {
+                        stop_share(&share);
+                    }
+                }
+            })
+            .expect("Zeus 窗口共享清理线程无法建立");
+        sender
+    });
+}
+
+/// 从只读输入或系统停止回调发出清理，不阻塞 AppKit。
+pub fn stop_application(pid: i32) {
+    let targets = shares()
+        .lock()
+        .unwrap()
+        .values()
+        .filter(|share| share.pid == pid)
+        .cloned()
+        .collect::<Vec<_>>();
+    for share in &targets {
+        share.stopped.store(true, Ordering::Release);
+        share.active.store(false, Ordering::Release);
+        share.ready.notify_all();
+    }
+    if let Some(sender) = STOP_QUEUE.get() {
+        // 每个应用首次暂停才排队；容量覆盖所有活跃窗口。
+        // 清理持有原实例，迟到请求不能结束同 PID 的新共享。
+        let _ = sender.try_send(targets);
+    }
+}
+
+/// 正常结束必须释放流；持锁串行化尚未完成的启动。
+fn stop_share(share: &WindowShare) {
+    share.stopped.store(true, Ordering::Release);
+    share.active.store(false, Ordering::Release);
+    share.ready.notify_all();
+    if let Some(stream) = share.stream.lock().unwrap().take() {
+        let _ = stream.stop_capture();
+    }
+    share.frame.lock().unwrap().sample = None;
+}
+
+/// 命名会话结束只移除自己的引用，最后一个所有者负责停止。
+pub fn end_session(session: &str) {
+    let ended = {
+        let mut records = shares().lock().unwrap();
+        let mut ended = Vec::new();
+        records.retain(|_, share| {
+            let mut sessions = share.sessions.lock().unwrap();
+            sessions.remove(session);
+            if sessions.is_empty() {
+                ended.push(share.clone());
+                false
+            } else {
+                true
+            }
+        });
+        ended
+    };
+    for share in ended {
+        stop_share(&share);
+    }
+}
+
+/// 成功观察的单窗口建立真实 SCStream，复用时仍核对原生停止状态。
+pub fn observe_window(session: &str, pid: i32, window_id: u32) -> anyhow::Result<()> {
+    crate::input::user_guard::check_pid(pid)?;
+    let key = (pid, window_id);
+    let existing = shares().lock().unwrap().get(&key).cloned();
+    if let Some(share) = existing {
+        anyhow::ensure!(
+            share.active.load(Ordering::Acquire) && !share.stopped.load(Ordering::Acquire),
+            "ZEUS_COMPUTER_SHARING_STOPPED: 窗口共享已停止，需要新指令。"
+        );
+        refresh_share(&share)?;
+        share.sessions.lock().unwrap().insert(session.to_owned());
+        return Ok(());
+    }
+    let share = Arc::new(WindowShare {
+        pid,
+        window_id,
+        sessions: Mutex::new(HashSet::from([session.to_owned()])),
+        stream: Mutex::new(None),
+        stopped: AtomicBool::new(false),
+        active: AtomicBool::new(false),
+        source_clock: OnceLock::new(),
+        geometry: Mutex::new(None),
+        captured_at: Mutex::new(None),
+        frame: Mutex::new(SharedFrame {
+            sample: None,
+            verified_at: None,
+            expected_size: (0, 0),
+        }),
+        ready: Condvar::new(),
+    });
+    {
+        let mut records = shares().lock().unwrap();
+        anyhow::ensure!(
+            records.len() < MAX_SHARED_WINDOWS,
+            "ZEUS_COMPUTER_SHARING_LIMIT: 同时共享窗口已达到上限，请先结束已有控制。"
+        );
+        records.insert(key, share.clone());
+    }
+    let result = start_share(&share);
+    if result.is_err() {
+        shares().lock().unwrap().remove(&key);
+        stop_share(&share);
+    }
+    result
+}
+
+/// 采集过滤器从实际 PID 和窗口创建，音频、物理鼠标和其他窗口都不采集。
+fn share_configuration(
+    share: &WindowShare,
+) -> anyhow::Result<(SCContentFilter, SCStreamConfiguration, [f64; 4])> {
+    let geometry = current_geometry(share)?;
+    let content = SCShareableContent::get()?;
+    let window = content
+        .windows()
+        .into_iter()
+        .find(|window| {
+            window.window_id() == share.window_id
+                && window
+                    .owning_application()
+                    .is_some_and(|app| app.process_id() == share.pid)
+        })
+        .ok_or_else(|| {
+            anyhow::anyhow!("ZEUS_COMPUTER_WINDOW_CHANGED: 无法核对共享窗口的应用身份。")
+        })?;
+    let filter = SCContentFilter::create().with_window(&window).build();
+    let scale = f64::from(filter.point_pixel_scale());
+    // 固定窗口的 WindowServer 几何跨系统版本有效，避免依赖较新过滤器的空矩形。
+    let width = (geometry[2] * scale).round();
+    let height = (geometry[3] * scale).round();
+    anyhow::ensure!(
+        width.is_finite()
+            && height.is_finite()
+            && width >= 1.0
+            && height >= 1.0
+            && width <= 16_384.0
+            && height <= 16_384.0
+            && width * height * 4.0 <= MAX_FRAME_BYTES as f64,
+        "ZEUS_COMPUTER_CAPTURE_LIMIT: 窗口像素尺寸超出共享内存上限。"
+    );
+    let config = SCStreamConfiguration::new()
+        .with_width(width as u32)
+        .with_height(height as u32)
+        .with_pixel_format(PixelFormat::BGRA)
+        .with_queue_depth(3)
+        .with_minimum_frame_interval(&CMTime::new(FRAME_INTERVAL, 1_000))
+        .with_shows_cursor(false)
+        .with_captures_audio(false);
+    let mut frame = share.frame.lock().unwrap();
+    frame.sample = None;
+    frame.verified_at = None;
+    frame.expected_size = (width as usize, height as usize);
+    Ok((filter, config, geometry))
+}
+
+/// 尺寸或位置改变时仍只更新同一精确窗口，禁止采集范围扩大。
+fn refresh_share(share: &WindowShare) -> anyhow::Result<()> {
+    if *share.geometry.lock().unwrap() == Some(current_geometry(share)?) {
+        return Ok(());
+    }
+    let owned_stream = share.stream.lock().unwrap();
+    crate::input::user_guard::check_pid(share.pid)?;
+    anyhow::ensure!(
+        !share.stopped.load(Ordering::Acquire),
+        "ZEUS_COMPUTER_SHARING_STOPPED: 窗口共享已停止。"
+    );
+    let stream = owned_stream
+        .as_ref()
+        .ok_or_else(|| anyhow::anyhow!("窗口共享尚未启动。"))?;
+    let (filter, config, geometry) = share_configuration(share)?;
+    stream.update_content_filter(&filter)?;
+    stream.update_configuration(&config)?;
+    anyhow::ensure!(
+        current_geometry(share)? == geometry,
+        "ZEUS_COMPUTER_WINDOW_CHANGED: 配置期间窗口发生变化。"
+    );
+    *share.geometry.lock().unwrap() = Some(geometry);
+    crate::input::user_guard::check_pid(share.pid)
+}
+
+/// 配置、输出和系统时钟全部就绪后才报告共享可用。
+fn start_share(share: &Arc<WindowShare>) -> anyhow::Result<()> {
+    let mut owned_stream = share.stream.lock().unwrap();
+    anyhow::ensure!(
+        !share.stopped.load(Ordering::Acquire),
+        "ZEUS_COMPUTER_SHARING_STOPPED: 窗口共享在启动前已停止。"
+    );
+    let (filter, config, geometry) = share_configuration(share)?;
+    let mut stream =
+        SCStream::new_with_delegate(&filter, &config, ShareDelegate(Arc::downgrade(share)));
+    let weak_share = Arc::downgrade(share);
+    anyhow::ensure!(
+        stream
+            .add_output_handler(
+                move |sample: CMSampleBuffer, kind: SCStreamOutputType| {
+                    if kind != SCStreamOutputType::Screen {
+                        return;
+                    }
+                    let Some(share) = weak_share.upgrade() else {
+                        return;
+                    };
+                    if share.stopped.load(Ordering::Acquire) {
+                        return;
+                    }
+                    let status = frame_status(&sample);
+                    let mut frame = share.frame.lock().unwrap();
+                    let timestamp = sample_seconds(&share, &sample);
+                    if status == Some(SCFrameStatus::Complete)
+                        && sample.image_buffer().is_some_and(|buffer| {
+                            (buffer.width(), buffer.height()) == frame.expected_size
+                        })
+                    {
+                        frame.sample = Some(sample);
+                        frame.verified_at = timestamp;
+                    } else if status == Some(SCFrameStatus::Idle) && frame.sample.is_some() {
+                        frame.verified_at = timestamp;
+                    } else {
+                        return;
+                    }
+                    share.ready.notify_all();
+                },
+                SCStreamOutputType::Screen
+            )
+            .is_some(),
+        "ZEUS_COMPUTER_CAPTURE_UNAVAILABLE: 无法建立窗口帧输出。"
+    );
+    stream.start_capture()?;
+    let source_clock = stream.synchronization_clock().ok_or_else(|| {
+        anyhow::anyhow!("ZEUS_COMPUTER_CAPTURE_UNAVAILABLE: 系统共享未提供真实采集时钟。")
+    })?;
+    // 当前绑定从系统借用时钟但未保留，为共享对象取得一次正式引用。
+    extern "C" {
+        /// 为共享生命周期保留一次系统时钟引用。
+        fn CFRetain(value: *const std::ffi::c_void) -> *const std::ffi::c_void;
+    }
+    unsafe {
+        CFRetain(source_clock.as_ptr());
+    }
+    let _ = share.source_clock.set(source_clock);
+    *owned_stream = Some(stream);
+    crate::input::user_guard::check_pid(share.pid)?;
+    anyhow::ensure!(
+        !share.stopped.load(Ordering::Acquire),
+        "ZEUS_COMPUTER_SHARING_STOPPED: 窗口共享在启动期间已停止。"
+    );
+    anyhow::ensure!(
+        current_geometry(share)? == geometry,
+        "ZEUS_COMPUTER_WINDOW_CHANGED: 启动期间窗口发生变化。"
+    );
+    *share.geometry.lock().unwrap() = Some(geometry);
+    share.active.store(true, Ordering::Release);
+    Ok(())
+}
+
+/// 只返回请求开始后由系统重新验证的画面，停止后不走截图回退。
+pub fn screenshot_window_bytes(window_id: u32) -> anyhow::Result<Vec<u8>> {
+    let started = Instant::now();
+    let requested_at = host_seconds()?;
+    let info = crate::windows::window_info_by_id(window_id)
+        .ok_or_else(|| anyhow::anyhow!("ZEUS_COMPUTER_WINDOW_CHANGED: 共享窗口已关闭。"))?;
+    let share = shares()
+        .lock()
+        .unwrap()
+        .get(&(info.pid, window_id))
+        .cloned()
+        .ok_or_else(|| anyhow::anyhow!("ZEUS_COMPUTER_OBSERVATION_REQUIRED: 窗口尚未建立共享。"))?;
+    let (sample, sampled_at) = {
+        let mut frame = share.frame.lock().unwrap();
+        loop {
+            crate::input::user_guard::check_pid(share.pid)?;
+            anyhow::ensure!(
+                share.active.load(Ordering::Acquire) && !share.stopped.load(Ordering::Acquire),
+                "ZEUS_COMPUTER_SHARING_STOPPED: 窗口共享已停止。"
+            );
+            if frame.verified_at.is_some_and(|time| time >= requested_at) {
+                if let Some(sample) = frame.sample.clone() {
+                    break (sample, frame.verified_at.unwrap());
+                }
+            }
+            let remaining = FRAME_TIMEOUT.saturating_sub(started.elapsed());
+            anyhow::ensure!(
+                !remaining.is_zero(),
+                "ZEUS_COMPUTER_CAPTURE_UNAVAILABLE: 未及时收到新的窗口帧。"
+            );
+            frame = share
+                .ready
+                .wait_timeout(frame, remaining.min(Duration::from_millis(16)))
+                .unwrap()
+                .0;
+        }
+    };
+    // 从系统帧时钟映射到 UTC，排除 PNG 编码和跨进程返回的耗时。
+    let captured_at = SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis() as f64
+        + (sampled_at - host_seconds()?) * 1_000.0;
+    anyhow::ensure!(
+        captured_at.is_finite() && captured_at >= 0.0 && captured_at <= 8_640_000_000_000_000.0,
+        "窗口帧采集时间无效。"
+    );
+    let buffer = sample
+        .image_buffer()
+        .ok_or_else(|| anyhow::anyhow!("共享帧没有图像缓冲。"))?;
+    let width = buffer.width();
+    let height = buffer.height();
+    let stride = buffer.bytes_per_row();
+    anyhow::ensure!(
+        width > 0
+            && height > 0
+            && width <= 16_384
+            && height <= 16_384
+            && width
+                .checked_mul(height)
+                .and_then(|pixels| pixels.checked_mul(4))
+                .is_some_and(|bytes| bytes <= MAX_FRAME_BYTES)
+            && stride >= width * 4
+            && stride
+                .checked_mul(height)
+                .is_some_and(|bytes| bytes <= MAX_FRAME_BYTES * 2)
+            && buffer.pixel_format() == 0x42475241,
+        "共享帧的尺寸或像素格式无效。"
+    );
+    let locked = buffer
+        .lock_read_only()
+        .map_err(|code| anyhow::anyhow!("共享帧无法锁定：{code}"))?;
+    anyhow::ensure!(!locked.base_address().is_null(), "共享帧没有可读像素。");
+    let mut rgba = vec![0u8; width * height * 4];
+    for row in 0..height {
+        // CoreVideo 的锁保证每行 stride 字节有效，尺寸在分配前已核对。
+        let pixels = unsafe {
+            std::slice::from_raw_parts(locked.base_address().add(row * stride), width * 4)
+        };
+        for (source, target) in pixels
+            .chunks_exact(4)
+            .zip(rgba[row * width * 4..(row + 1) * width * 4].chunks_exact_mut(4))
+        {
+            target.copy_from_slice(&[source[2], source[1], source[0], source[3]]);
+        }
+    }
+    drop(locked);
+    crate::input::user_guard::check_pid(share.pid)?;
+    let current = crate::windows::window_info_by_id(window_id)
+        .ok_or_else(|| anyhow::anyhow!("共享窗口在截图期间已关闭。"))?;
+    anyhow::ensure!(
+        current.pid == info.pid
+            && current.bounds.x == info.bounds.x
+            && current.bounds.y == info.bounds.y
+            && current.bounds.width == info.bounds.width
+            && current.bounds.height == info.bounds.height,
+        "ZEUS_COMPUTER_WINDOW_CHANGED: 窗口在截图期间发生变化，需要重新观察。"
+    );
+    let mut png = Vec::new();
+    image::codecs::png::PngEncoder::new(&mut png).write_image(
+        &rgba,
+        width as u32,
+        height as u32,
+        image::ExtendedColorType::Rgba8,
+    )?;
+    crate::input::user_guard::check_pid(share.pid)?;
+    anyhow::ensure!(
+        !share.stopped.load(Ordering::Acquire),
+        "ZEUS_COMPUTER_SHARING_STOPPED: 窗口共享在编码期间停止。"
+    );
+    *share.captured_at.lock().unwrap() = Some(captured_at.round() as u64);
+    Ok(png)
+}
+
+/// 仅提取已交付图片的采集时间，AX-only 观察不会产生新时间。
+pub fn capture_time(pid: i32, window_id: u32) -> Option<u64> {
+    let share = shares().lock().unwrap().get(&(pid, window_id)).cloned()?;
+    let captured_at = *share.captured_at.lock().unwrap();
+    captured_at
+}
+
+/// 观察结果报告实际系统共享状态，不能由界面推测。
+pub fn is_active(pid: i32, window_id: u32) -> bool {
+    shares()
+        .lock()
+        .unwrap()
+        .get(&(pid, window_id))
+        .is_some_and(|share| {
+            share.active.load(Ordering::Acquire) && !share.stopped.load(Ordering::Acquire)
+        })
+}
