+impl Drop for MacSurface {
+    /// 在主队列关闭并释放原生窗口，不触碰用户应用。
+    fn drop(&mut self) {
+        #[link(name = "System", kind = "framework")]
+        extern "C" {
+            static _dispatch_main_q: u8;
+            fn dispatch_async_f(
+                queue: *const c_void,
+                context: *mut c_void,
+                work: unsafe extern "C" fn(*mut c_void),
+            );
+        }
+        /// 等待已排队的图层回调结束后释放最后一份窗口引用。
+        unsafe extern "C" fn close_window(context: *mut c_void) {
+            let pointer = *Box::from_raw(context as *mut usize);
+            let window = pointer as *mut objc2::runtime::AnyObject;
+            let _: () = objc2::msg_send![window, close];
+            let _: () = objc2::msg_send![window, release];
