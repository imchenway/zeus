{
  "name": "@zeus/desktop",
  "version": "0.2.18",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "../../script/build_and_run.sh",
    "build": "node scripts/clean-build-output.mjs && vite build && tsc -p tsconfig.preload.json && node scripts/bundle-preload.mjs && tsc -p tsconfig.main.json",
    "package:mac": "ZEUS_PACKAGE_VARIANT=test node ../../scripts/package-mac.mjs",
    "package:mac:test": "ZEUS_PACKAGE_VARIANT=test node ../../scripts/package-mac.mjs",
    "package:mac:release": "ZEUS_PACKAGE_VARIANT=release ZEUS_RELEASE_BUILD=1 node ../../scripts/package-mac.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.0",
    "@zeus/ai-runtime": "workspace:*",
    "@zeus/diagram-engine": "workspace:*",
    "@zeus/local-server": "workspace:*",
    "@zeus/shared": "workspace:*",
    "framer-motion": "12.42.0",
    "graphology": "^0.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "^3.0.3"
  },
  "description": "Zeus AI development workbench for projects, coding agents, code intelligence, and Git workflows",
  "author": "Zeus Contributors"
}
