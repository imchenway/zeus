{
  "name": "zeus",
  "version": "0.3.28",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zeus/desktop dev",
    "qa:browser": "pnpm --filter @zeus/desktop exec vite --host 127.0.0.1 --port 4179 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "build": "pnpm -r --if-present build",
    "package:mac": "pnpm --filter @zeus/desktop package:mac",
    "package:mac:test": "pnpm --filter @zeus/desktop package:mac:test",
    "package:mac:release": "pnpm --filter @zeus/desktop package:mac:release",
    "release": "node scripts/release-all.mjs",
    "release:gate": "node scripts/run-release-gate.mjs",
    "release:commands:sync": "pnpm --filter @zeus/shared build && node scripts/sync-release-commands.mjs",
    "release:notes:draft": "node scripts/generate-release-notes-draft.mjs",
    "release:prepare": "node scripts/prepare-release-candidate.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "verify:publish": "node scripts/verify-publish.mjs",
    "verify:release": "bash scripts/verify-release.sh",
    "verify:acceptance-matrix": "node scripts/verify-acceptance-matrix.mjs --check",
    "format": "prettier --write \"**/*.{ts,tsx,cts,cjs,mjs,js,json,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,cts,cjs,mjs,js,json,yml,yaml}\" --ignore-path .prettierignore",
    "security:audit": "pnpm audit --audit-level=moderate",
    "verify:quick": "pnpm verify:publish"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "fastify": "^5.4.0",
    "nanoid": "^5.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-git": "^3.28.0",
    "sql.js": "^1.13.0",
    "tsx": "^4.20.3",
    "ws": "^8.18.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "42.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.29.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^8.0.16"
  },
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=10 <11"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imchenway/zeus.git"
  },
  "bugs": {
    "url": "https://github.com/imchenway/zeus/issues"
  },
  "homepage": "https://github.com/imchenway/zeus#readme",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "@earendil-works/pi-ai@0.83.0>@aws-sdk/client-bedrock-runtime": "-",
      "@earendil-works/pi-ai@0.83.0>@google/genai": "-",
      "@earendil-works/pi-ai@0.83.0>@mistralai/mistralai": "-",
      "@earendil-works/pi-ai@0.83.0>@opentelemetry/api": "-",
      "@earendil-works/pi-ai@0.83.0>@smithy/node-http-handler": "-",
      "@earendil-works/pi-ai@0.83.0>http-proxy-agent": "-",
      "@earendil-works/pi-ai@0.83.0>https-proxy-agent": "-",
      "@earendil-works/pi-coding-agent@0.83.0>@earendil-works/pi-tui": "-",
      "@earendil-works/pi-coding-agent@0.83.0>@mariozechner/clipboard": "-",
      "@earendil-works/pi-coding-agent@0.83.0>@silvia-odwyer/photon-node": "-",
      "@earendil-works/pi-coding-agent@0.83.0>highlight.js": "-"
    },
    "patchedDependencies": {
      "@earendil-works/pi-ai@0.83.0": "patches/@earendil-works__pi-ai@0.83.0.patch",
      "@earendil-works/pi-coding-agent@0.83.0": "patches/@earendil-works__pi-coding-agent@0.83.0.patch"
    }
  }
}
